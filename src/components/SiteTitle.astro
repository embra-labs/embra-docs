---
// The console's wordmark: a black tile with the white Embra "E", "Embra", then a muted "Docs".
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
	<span class="mark" aria-hidden="true">
		<svg viewBox="13.5 8 37 40" focusable="false">
			<path
				fill="currentColor"
				d="M25.5 8L30.5 8L29.5 12L50.5 12L48.5 20L30.5 20L29.5 24L42.5 24L40.5 32L27.5 32L26.5 36L44.5 36L43.5 40L38.5 44L21.5 44L20.5 48L15.5 48L16.5 44L13.5 44L20.5 16L21.5 12L24.5 12Z"
			></path>
		</svg>
	</span>
	<span class="name" translate="no">Embra</span>
	<span class="section">Docs</span>
</a>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}
	.mark {
		display: inline-grid;
		place-items: center;
		flex: none;
		width: 26px;
		height: 26px;
		border-radius: var(--r-sm);
		background: var(--ink);
		color: #ffffff;
	}
	.mark svg {
		width: 13px;
		height: 14px;
	}
	.name {
		font: 700 var(--text-lg) / 1 var(--font-sans);
		letter-spacing: -0.02em;
	}
	.section {
		padding-inline-start: 10px;
		border-inline-start: 1px solid var(--line);
		font: 500 var(--text-md) / 1 var(--font-sans);
		color: var(--ink-3);
	}
</style>
